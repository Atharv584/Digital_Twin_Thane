# API Keys (all free, no credit card required)
# Only 3 of 14 APIs need keys — the rest work out of the box

# WAQI Air Quality — get yours at https://aqicn.org/data-platform/token/
WAQI_API_KEY=your_waqi_token_here

# GNews — get yours at https://gnews.io/register
GNEWS_API_KEY=your_gnews_key_here

# Groq Cloud LLM — get yours at https://console.groq.com/
GROQ_API_KEY=your_groq_key_here

# Groq Model Name — choose any Groq-supported model:
#   llama-3.3-70b-versatile  (recommended, fast & capable)
#   llama3-70b-8192
#   mixtral-8x7b-32768
#   gemma2-9b-it
GROQ_MODEL_NAME=llama-3.3-70b-versatile
